# ─────────────────────────────────────────────────────────────
# ELK-Workflow — Required Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────────────────────

# Supabase — exposed to the browser (safe, governed by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase — SECRET, server-side only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenRouter — SECRET, server-side only
# Get a free key at https://openrouter.ai → Dashboard → Keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
